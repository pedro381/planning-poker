    [Parameter]
    public IReadOnlyList<Participant> Participants { get; set; } = [];

    [Parameter]
    public bool VotesRevealed { get; set; }

    [Parameter]
    public string CurrentParticipantId { get; set; } = string.Empty;

    [Parameter]
    public IReadOnlyList<PoopThrow> PoopThrows { get; set; } = [];

    [Parameter]
    public EventCallback<EmojiThrowRequest> OnThrowEmoji { get; set; }

    private CancellationTokenSource? _hoverDelayCts;
    private string? _hoveringParticipantId;
    private string? _paletteParticipantId;
    private bool _isEmojiModalOpen;
    private string _emojiSearch = string.Empty;
    private string _selectedEmoji = "💩";
    private readonly Dictionary<string, ElementCenter> _participantCenters = [];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await RefreshParticipantCenters();
    }

    private bool HasIncomingPoop(string participantId)
    {
        return PoopThrows.Any(t => t.TargetParticipantId == participantId);
    }

    private string BuildThrowStyle(PoopThrow poopThrow)
    {
        var hasCenter = _participantCenters.TryGetValue(poopThrow.TargetParticipantId, out var center);
        var toX = hasCenter && center is not null ? center.X : 50d;
        var toY = hasCenter && center is not null ? center.Y : 50d;

        return string.Create(CultureInfo.InvariantCulture,
            $"--from-x-vw:{poopThrow.FromXVw:0.##}; --from-y-vh:{poopThrow.FromYVh:0.##}; --from-rot:{poopThrow.FromRotationDeg:0.##}deg; --duration:{poopThrow.DurationMs}ms; --to-x-vw:{toX:0.##}; --to-y-vh:{toY:0.##};");
    }

    private static string BuildTargetElementId(string participantId) => $"participant-target-{participantId}";

    private async Task RefreshParticipantCenters()
    {
        if (Participants.Count == 0)
        {
            return;
        }

        foreach (var participant in Participants)
        {
            var elementId = BuildTargetElementId(participant.Id);
            var center = await Js.InvokeAsync<ElementCenter?>("pokerEmoji.getElementCenter", elementId);
            if (center is not null)
            {
                _participantCenters[participant.Id] = center;
            }
        }
    }

    private void BeginHover(string participantId)
    {
        _hoveringParticipantId = participantId;
        _hoverDelayCts?.Cancel();
        _hoverDelayCts?.Dispose();
        _hoverDelayCts = new CancellationTokenSource();

        _ = ShowPaletteAfterDelay(participantId, _hoverDelayCts.Token);
    }

    private void OnHoverLeft()
    {
        _hoveringParticipantId = null;
        _hoverDelayCts?.Cancel();
    }

    private async Task ShowPaletteAfterDelay(string participantId, CancellationToken cancellationToken)
    {
        try
        {
            await Task.Delay(1000, cancellationToken);
            if (!cancellationToken.IsCancellationRequested && _hoveringParticipantId == participantId)
            {
                _paletteParticipantId = participantId;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (TaskCanceledException)
        {
        }
    }

    private void KeepPaletteVisible()
    {
        _hoverDelayCts?.Cancel();
    }

    private void HidePalette()
    {
        _paletteParticipantId = null;
    }

    private void SelectEmoji(string emoji)
    {
        _selectedEmoji = emoji;
        _paletteParticipantId = null;
    }

    private async Task ThrowSelectedEmoji(string participantId)
    {
        _paletteParticipantId = null;

        await OnThrowEmoji.InvokeAsync(new EmojiThrowRequest
        {
            TargetParticipantId = participantId,
            Emoji = _selectedEmoji
        });
    }

    private void OpenEmojiModal()
    {
        _emojiSearch = string.Empty;
        _isEmojiModalOpen = true;
        _paletteParticipantId = null;
    }

    private void CloseEmojiModal()
    {
        _isEmojiModalOpen = false;
    }

    private void ThrowEmojiFromModal(string emoji)
    {
        _selectedEmoji = emoji;
        CloseEmojiModal();
    }

    private IEnumerable<EmojiOption> FilteredModalOptions()
    {
        if (string.IsNullOrWhiteSpace(_emojiSearch))
        {
            return _modalEmojiOptions;
        }

        return _modalEmojiOptions.Where(option =>
            option.Label.Contains(_emojiSearch, StringComparison.OrdinalIgnoreCase) ||
            option.Symbol.Contains(_emojiSearch, StringComparison.OrdinalIgnoreCase));
    }

    public void Dispose()
    {
        _hoverDelayCts?.Cancel();
        _hoverDelayCts?.Dispose();
    }

    private sealed record EmojiOption(string Symbol, string Label);

    private sealed class ElementCenter
    {
        public double X { get; set; }

        public double Y { get; set; }
    }
}
