@using Poker.Models
@using System.Globalization
@implements IDisposable
@inject IJSRuntime Js

<section class="participants-card">
    <div class="participants-header">
        <h2>Participantes</h2>
        <span>@Participants.Count</span>
    </div>

    <ul>
        @foreach (var participant in Participants)
        {
            <li class="participant-item @(HasIncomingPoop(participant.Id) ? "emoji-target" : string.Empty)">
                <div class="name-cell" @onmouseenter="() => BeginHover(participant.Id)" @onmouseleave="OnHoverLeft">
                    <button
                        id="@BuildTargetElementId(participant.Id)"
                        type="button"
                        class="name-hit-btn"
                        title="Lancar emoji"
                        @onclick="() => ThrowSelectedEmoji(participant.Id)">
                        <strong>@participant.Name</strong>
                    </button>
                    @if (participant.Id == CurrentParticipantId)
                    {
                        <small>Você</small>
                    }

                    @if (_paletteParticipantId == participant.Id)
                    {
                        <div class="emoji-palette" @onmouseenter="KeepPaletteVisible" @onmouseleave="HidePalette">
                            @foreach (var option in _quickEmojiOptions)
                            {
                                <button
                                    type="button"
                                    class="emoji-option @(option.Symbol == _selectedEmoji ? "selected" : string.Empty)"
                                    title="@option.Label"
                                    @onclick="() => SelectEmoji(option.Symbol)">
                                    @option.Symbol
                                </button>
                            }
                            <button type="button" class="emoji-option more" @onclick="OpenEmojiModal">+</button>
                        </div>
                    }
                </div>

                @if (VotesRevealed)
                {
                    <span class="status vote-value">@(participant.Vote ?? "-")</span>
                }
                else
                {
                    <span class="status @(participant.HasVoted ? "voted" : "waiting")">
                        @(participant.HasVoted ? "Votou" : "Aguardando")
                    </span>
                }
            </li>
        }
    </ul>
</section>

<div class="emoji-overlay" aria-hidden="true">
    @foreach (var poopThrow in PoopThrows)
    {
        <span
            @key="poopThrow.Id"
            class="emoji-throw"
            style="@BuildThrowStyle(poopThrow)"
            aria-hidden="true">
            @poopThrow.Emoji
        </span>
    }
</div>

@if (_isEmojiModalOpen)
{
    <div class="emoji-modal-backdrop" @onclick="CloseEmojiModal">
        <div class="emoji-modal" @onclick:stopPropagation="true">
            <div class="emoji-modal-header">
                <h3>Escolher Emoji</h3>
                <button type="button" class="close-modal" @onclick="CloseEmojiModal">x</button>
            </div>

            <input
                class="emoji-search"
                placeholder="Pesquisar emoji"
                @bind-value="_emojiSearch"
                @bind-value:event="oninput" />

            <div class="emoji-grid">
                @foreach (var option in FilteredModalOptions())
                {
                    <button type="button" class="emoji-option" title="@option.Label" @onclick="() => ThrowEmojiFromModal(option.Symbol)">@option.Symbol</button>
                }
            </div>
        </div>
    </div>
}

